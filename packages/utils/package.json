{
  "name": "@term-extractor/utils",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared, generic cross-package utilities. Each util is its own file, imported by its own subpath (no barrel).",
  "exports": {
    "./opensearch-fetch": {
      "types": "./dist/opensearch-fetch.d.ts",
      "import": "./dist/opensearch-fetch.js"
    },
    "./perf": {
      "types": "./dist/perf.d.ts",
      "import": "./dist/perf.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  }
}
