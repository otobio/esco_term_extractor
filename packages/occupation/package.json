{
  "name": "occupation-search-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CLI utilities for building and exploring the occupation search engine schema.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "artifacts/runtime/occupation-*"
  ],
  "scripts": {
    "build": "tsc --pretty false && node scripts/copy-classifier-runtime-files.mjs",
    "build:tests": "rm -rf dist/tests && tsc -p tsconfig.tests.json --pretty false && node scripts/copy-classifier-runtime-files.mjs --tests",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --fix",
    "format": "biome format --write .",
    "check:dev": "npm run typecheck && npm run lint",
    "check:pre-commit-limits": "npm run build && node scripts/check-pre-commit-limits.mjs",
    "test:slow": "npm run build:tests && node --test --test-concurrency=1 dist/tests/slow/*.test.js",
    "test:enrichments": "npm run build:tests && node --test --test-concurrency=1 dist/tests/enrichment/*.test.js",
    "check": "npm run db:check",
    "db:check": "npm run build && node dist/cli/check-db.js",
    "db:apply-schema": "npm run build && node dist/cli/apply-schema.js",
    "audit:esco-source": "npm run build && node dist/cli/audit-esco-source.js",
    "audit:esco-source:json": "npm run build && node dist/cli/audit-esco-source.js --format=json",
    "audit:search-meta": "npm run build && node dist/cli/audit-occupation-search-meta.js",
    "audit:search-meta:json": "npm run build && node dist/cli/audit-occupation-search-meta.js --format=json",
    "synonym:variant": "npm run build && node dist/cli/synonym-variant.js",
    "graph:capabilities": "npm run build && node dist/cli/build-capability-graph.js",
    "graph:capabilities:en": "npm run build && node dist/cli/build-capability-graph.js --locales=en",
    "graph:occupations": "npm run build && node dist/cli/build-occupation-graph.js",
    "graph:occupations:en": "npm run build && node dist/cli/build-occupation-graph.js --locales=en",
    "taxonomy:placements": "npm run build && node dist/cli/inspect-taxonomy-placements.js",
    "import:esco": "npm run build && node dist/cli/import-esco-source.js",
    "import:esco:en": "npm run build && node dist/cli/import-esco-source.js --locales=en",
    "import:eures:aliases": "npm run build && node dist/cli/import-eures-esco-alias-candidates.js",
    "import:eures:aliases:promote": "npm run build && node dist/cli/promote-eures-esco-alias-candidates.js",
    "import:onet:aliases": "npm run build && node dist/cli/import-onet-esco-alias-candidates.js",
    "import:onet:aliases:promote": "npm run build && node dist/cli/promote-onet-esco-alias-candidates.js",
    "skills:esco:related-terms:inspect": "npm run build && node scripts/skills/inspect-esco-related-terms.js",
    "skills:esco:related-terms:runtime": "npm run build && node scripts/skills/export-esco-related-terms-runtime.js",
    "opensearch:create:occupations": "npm run build && node dist/cli/create-opensearch-occupations-index.js",
    "opensearch:create:occupation-aliases": "npm run build && node dist/cli/create-opensearch-occupation-aliases-index.js",
    "opensearch:populate:occupation-aliases": "npm run build && node dist/cli/populate-opensearch-occupation-aliases.js",
    "opensearch:populate:occupations": "npm run build && node dist/cli/populate-opensearch-occupations.js",
    "review:aliases:apply-family": "npm run build && node dist/cli/apply-automated-alias-review.js",
    "review:aliases:auto": "npm run build && node dist/cli/build-automated-alias-review.js",
    "review:noise:extract": "node scripts/extract-noise-patterns.js",
    "review:noise:sample": "node scripts/extract-noise-patterns.js --sample=100",
    "review:noise:audit": "node scripts/extract-noise-patterns.js --sample=100 --audit-out=data/taxonomy-review/job-title-noise-audit.sample.csv",
    "review:triage:pilot": "npm run build && node scripts/build-llm-job-title-triage-pilot.js --locale=ro --sample=100 --seed=llm-job-title-triage-pilot-ro",
    "review:triage:pilot:all": "npm run build && node scripts/build-llm-job-title-triage-pilot.js --locale=ro --sample=all --seed=llm-job-title-triage-pilot-ro-all --out=data/taxonomy-review/job-title-triage-pilot.ro.all.jsonl --manifest=data/taxonomy-review/job-title-triage-pilot.ro.all.manifest.json",
    "review:triage:pilot:merge": "node scripts/merge-llm-job-title-triage-pilot-chunks.js",
    "review:triage:brief": "node scripts/build-llm-job-title-review-brief.js",
    "review:triage:brief:all": "node scripts/build-llm-job-title-review-brief.js --input=data/taxonomy-review/job-title-triage-pilot.ro.all.jsonl --out-tsv=data/taxonomy-review/job-title-triage-brief.ro.all.tsv --out-columns=data/taxonomy-review/job-title-triage-brief.columns.json --manifest=data/taxonomy-review/job-title-triage-brief.ro.all.manifest.json",
    "review:triage:batches:all": "node scripts/split-llm-job-title-review-tsv.js --input=data/taxonomy-review/job-title-triage-brief.ro.all.tsv --out-dir=data/taxonomy-review/job-title-triage-batches.ro.all --manifest=data/taxonomy-review/job-title-triage-batches.ro.all.manifest.json --batch-size=25",
    "review:triage:bundle": "node scripts/prepare-llm-job-title-review-bundle.js --locale=ro",
    "review:triage:aggregate": "node scripts/aggregate-llm-job-title-triage-proposals.js",
    "review:triage:llm:direct": "node scripts/run-llm-job-title-triage-direct.js",
    "review:triage:smoke": "node scripts/run-llm-job-title-triage-smoke.js",
    "enrich:via-job-title:help": "node scripts/print-job-title-enrichment-workflow.js",
    "enrich:via-job-title:prepare": "node scripts/run-job-title-enrichment-prepare.js",
    "enrich:via-job-title:resolution": "npm run build && node scripts/build-llm-job-title-triage-pilot.js",
    "enrich:via-job-title:resolution:chunks": "node scripts/run-job-title-enrichment-resolution-chunks.js",
    "enrich:via-job-title:query": "node scripts/build-llm-job-title-review-brief.js",
    "enrich:via-job-title:batches": "node scripts/split-llm-job-title-review-tsv.js",
    "enrich:via-job-title:bundle": "node scripts/prepare-llm-job-title-review-bundle.js",
    "enrich:via-job-title:review:direct": "node scripts/run-job-title-triage-direct-by-locale.js",
    "enrich:via-job-title:aggregate": "node scripts/aggregate-llm-job-title-triage-proposals.js",
    "enrich:via-job-title:seed:proposals": "node scripts/build-query-prep-seed-proposals.js",
    "enrich:via-job-title:stats:candidates": "node scripts/build-statistical-enrichment-candidates.js",
    "enrich:via-job-title:raw-discovery": "npm run build && node dist/cli/build-raw-title-chunk-discovery.js",
    "enrich:via-job-title:stats:promote": "node scripts/apply-statistical-enrichment-promotions.js",
    "enrich:via-job-title:promote:manual:help": "node scripts/print-job-title-promotion-guidance.js",
    "enrich:via-job-title:smoke": "node scripts/run-llm-job-title-triage-smoke.js",
    "runtime:check": "npm run build && node dist/cli/check-runtime-artifacts.js",
    "query:intent": "npm run build && node dist/cli/query-intent.js",
    "query:intent:audit": "npm run build && node dist/cli/audit-occupation-intent-vocabulary.js",
    "query:intent:export-vocab": "npm run build && node dist/cli/export-occupation-intent-vocabulary-artifact.js",
    "query:leaf-structure:export": "npm run build && node dist/cli/export-occupation-leaf-structure-artifact.js",
    "query:reviewed-family-signals:export": "npm run build && node dist/cli/export-occupation-reviewed-family-signals-artifact.js",
    "query:role-head-equivalents:export": "npm run build && node dist/cli/export-occupation-role-head-equivalence-artifact.js",
    "query:family-token-relevance:export": "npm run build && node dist/cli/export-occupation-family-token-relevance-artifact.js",
    "query:family-capability-relevance:export": "npm run build && node dist/cli/export-occupation-family-capability-relevance-artifact.js",
    "query:reviewed-alias-seeds:generate": "npm run build && node dist/cli/generate-reviewed-alias-seeds.js",
    "query:signals": "npm run build && node dist/cli/clean-occupation-query-signals.js",
    "report-compare:classifier:csv": "npm run build && node dist/cli/report-occupation-classifier-comparison.js",
    "report-compare:noise:csv": "npm run build && node dist/cli/report-occupation-cleaning-comparison.js",
    "skills:esco:related-terms": "npm run build && node scripts/skills/export-esco-related-terms.js",
    "skills:esco:related-terms:build": "npm run build && node scripts/skills/build-esco-related-terms.js",
    "classification:occupation": "npm run build && node dist/cli/classify-occupation.js",
    "classification:occupation:esco-api": "npm run build && node dist/cli/classify-occupation-esco-api.js",
    "classification:specialization": "npm run build && node dist/cli/inspect-specialization-query.js",
    "test:classifier:specialization": "node scripts/run-classifier-tests.mjs --kind=unit --suite=specialization-dimension-mapper",
    "test:classifier:unit": "npm run build:tests && node scripts/run-classifier-tests.mjs --kind=unit",
    "test:classifier:integration": "npm run build:tests && node scripts/run-classifier-tests.mjs --kind=integration",
    "test:classifier": "npm run build:tests && node scripts/run-classifier-tests.mjs --kind=all",
    "test:esco-api-classifier": "npm run build:tests && node --test --test-concurrency=1 dist/tests/occupation-esco-api-classifier/unit/*.test.js",
    "classifier:family-structure:generate": "npm run build:tests && node scripts/occupation-classifier/generate-family-structure-rules.mjs",
    "classifier:family-structure:check": "npm run build:tests && node scripts/occupation-classifier/generate-family-structure-rules.mjs --check",
    "classifier:role-head-fixtures:generate": "npm run build:tests && node scripts/occupation-classifier/generate-role-head-inference-fixtures.mjs",
    "classifier:role-head-fixtures:check": "npm run build:tests && node scripts/occupation-classifier/generate-role-head-inference-fixtures.mjs --check",
    "query:signals:export-vocab": "npm run build && node dist/cli/export-occupation-signal-vocabulary-artifact.js",
    "retrieval:aliases:ngram:evaluate": "npm run build && node dist/cli/compare-alias-ngram-evaluation.js",
    "retrieval:aliases:ngram:batch": "npm run build && node dist/cli/probe-alias-ngram-batch.js",
    "retrieval:aliases:ngram:export": "npm run build && node dist/cli/export-occupation-alias-ngram-artifact.js",
    "retrieval:index:export": "npm run build && node dist/cli/export-occupation-retrieval-index-artifact.js",
    "retrieval:aliases:ngram": "npm run build && node dist/cli/probe-alias-ngram-retrieval.js",
    "runtime:artifacts-build": "npm run search-meta:export-runtime && npm run search-meta:export-review-runtime && npm run retrieval:index:export && npm run search-meta:export-family-profiles && npm run retrieval:aliases:ngram:export -- --locales=en,ro,hu,et,lt,lv --include-family-supporting && npm run query:signals:export-vocab && npm run query:intent:export-vocab && npm run query:role-head-equivalents:export && npm run query:reviewed-family-signals:export && npm run query:family-token-relevance:export && npm run query:family-capability-relevance:export && npm run query:leaf-structure:export && npm run skills:esco:related-terms:runtime",
    "runtime:artifacts-rebuild-db": "npm run graph:occupations && npm run import:eures:aliases && npm run import:eures:aliases:promote && npm run import:onet:aliases && npm run import:onet:aliases:promote && npm run graph:capabilities && npm run search-meta:occupations && npm run runtime:artifacts-build",
    "search-meta:occupations": "npm run build && node dist/cli/build-occupation-search-meta.js",
    "search-meta:occupations:en": "npm run build && node dist/cli/build-occupation-search-meta.js --locales=en",
    "search-meta:export-family-profiles": "npm run build && node dist/cli/export-occupation-family-profile-artifact.js",
    "search-meta:export-review-runtime": "npm run build && node dist/cli/export-occupation-search-meta-review-artifact.js",
    "search-meta:export-runtime": "npm run build && node dist/cli/export-occupation-search-meta-artifact.js"
  },
  "dependencies": {
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^22.10.1",
    "mysql2": "^3.11.3",
    "typescript": "^5.6.3",
    "unzipper": "^0.12.3"
  }
}
